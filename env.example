# Copy to .env. Never commit .env or paste these values into Discord channels.
DISCORD_TOKEN=
# Generate ONCE: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable and back it up separately from the database.
NANNY_ENCRYPTION_KEY=
NANNY_DATABASE=data/chronicle.db
# Optional: sync slash commands instantly to a single test server (numeric ID).
# Leave blank for global commands; global registration may take time to propagate.
DISCORD_GUILD_ID=
